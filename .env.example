# ─── 服务端 ─────────────────────────────────────
PORT=3000
NODE_ENV=production
# 信任代理层数：Cloudflare → Nginx → Node 通常为 1
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
ENABLE_ACCESS_LOG=true

# ─── 站点信息 ───────────────────────────────────
SITE_NAME=导航门户
SITE_DOMAIN=example.com
SITE_NOTICE=谨防失联，牢记域名
SITE_SUBTITLE=安全稳定 · 多线路入口
JUMP_SECONDS=5
JUMP_TITLE=正在建立安全连接
JUMP_MESSAGE=您与网站之间的访问链路正在进行云端优化，请稍候...
JUMP_FOOTER=云端加速引擎 · 安全链路验证

# ─── 外部链接 ───────────────────────────────────
TG_URL=https://t.me/yourgroup
TG_TEXT=官方TG群组
DOWNLOAD_ANDROID=https://example.com/android.apk
DOWNLOAD_WINDOWS=https://example.com/windows.exe
DOWNLOAD_MAC=https://example.com/mac.dmg
DOWNLOAD_ANDROID_TEXT=安卓客户端
DOWNLOAD_WINDOWS_TEXT=Windows 客户端
DOWNLOAD_MAC_TEXT=Mac 客户端

# ─── 按钮文案 ───────────────────────────────────
PRIMARY_BUTTON_TEXT=牢记域名
HERO_BUTTON_TEXT=example.com

# ─── 线路配置 ───────────────────────────────────
NAV_LINK_COUNT=6

NAV_LINK_1_NAME=NO.1官网
NAV_LINK_1_URL=https://a.example.com/#/login
NAV_LINK_1_PING=https://a.example.com/ping.txt
NAV_LINK_1_ENABLED=true
NAV_LINK_1_BADGE=官网

NAV_LINK_2_NAME=NO.2官网
NAV_LINK_2_URL=https://b.example.com/#/login
NAV_LINK_2_PING=https://b.example.com/ping.txt
NAV_LINK_2_ENABLED=true
NAV_LINK_2_BADGE=官网

NAV_LINK_3_NAME=NO.3官网
NAV_LINK_3_URL=https://c.example.com/#/login
NAV_LINK_3_PING=https://c.example.com/ping.txt
NAV_LINK_3_ENABLED=true
NAV_LINK_3_BADGE=官网

NAV_LINK_4_NAME=NO.4备用
NAV_LINK_4_URL=https://d.example.com/#/login
NAV_LINK_4_PING=https://d.example.com/ping.txt
NAV_LINK_4_ENABLED=true
NAV_LINK_4_BADGE=备用

NAV_LINK_5_NAME=NO.5备用
NAV_LINK_5_URL=https://e.example.com/#/login
NAV_LINK_5_PING=https://e.example.com/ping.txt
NAV_LINK_5_ENABLED=true
NAV_LINK_5_BADGE=备用

NAV_LINK_6_NAME=NO.6备用
NAV_LINK_6_URL=https://f.example.com/#/login
NAV_LINK_6_PING=https://f.example.com/ping.txt
NAV_LINK_6_ENABLED=true
NAV_LINK_6_BADGE=备用

# ─── UA 拦截 ────────────────────────────────────
BLOCKED_UA_KEYWORDS=bot,curl,wget,python,scanner
ENABLE_UA_BLOCK=false

# ─── 测速配置 ───────────────────────────────────
PING_ENABLED=true
# 单次测速超时（毫秒）
PING_TIMEOUT=3000
# 服务端最大并发测速数
PING_MAX_CONCURRENT=3
# 测速结果缓存时间（毫秒），避免频繁请求
PING_CACHE_TTL=30000

# ─── API 限流 ───────────────────────────────────
RATE_LIMIT_ENABLED=true
# 限流时间窗口（毫秒）
RATE_LIMIT_WINDOW_MS=60000
# 普通 API 每分钟最大请求数
RATE_LIMIT_MAX=120
# 测速 API 每分钟最大请求数（更严格）
RATE_LIMIT_PING_MAX=30

# ─── 日志配置 ───────────────────────────────────
# 单日志文件最大大小（字节），默认 10MB
LOG_MAX_FILE_SIZE=10485760
# 最大保留轮转文件数
LOG_MAX_FILES=5
# IP 脱敏（true 时日志中 IP 只保留前两段）
LOG_ANONYMIZE_IP=false
LOG_ENABLE_JUMP=true
LOG_ENABLE_RISK=true
